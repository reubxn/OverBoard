{
  "manifest_version": 3,
  "name": "Overboard",
  "version": "1.0",
  "description": "Download locked content from Blackboard — no download button required.",
  "permissions": ["downloads", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blackboard PDF Downloader"
  }
}
